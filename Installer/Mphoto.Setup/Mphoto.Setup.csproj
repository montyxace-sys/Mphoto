<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Mphoto.Setup</RootNamespace>
    <AssemblyName>Mphoto.Setup</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Mphoto</Product>
    <Company>MSoft</Company>
    <AssemblyTitle>Instalador de Mphoto</AssemblyTitle>
    <Description>Instalador de Mphoto</Description>
    <ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.dev.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' != 'Debug'">app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\Mphoto.App\Assets\icon.ico</ApplicationIcon>
    <PayloadZip Condition="'$(PayloadZip)' == ''">$(MSBuildProjectDirectory)\..\..\publish\MphotoSetupPayload.zip</PayloadZip>
    <UninstallerExe Condition="'$(UninstallerExe)' == ''">$(MSBuildProjectDirectory)\..\Mphoto.Uninstall\bin\$(Configuration)\net48\Mphoto.Uninstall.exe</UninstallerExe>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- El núcleo se compila dentro del instalador para que MphotoSetup.exe sea un único archivo. -->
    <Compile Include="..\Mphoto.Installer.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\Shared\UiTheme.xaml" Link="UiTheme.xaml" />
    <Resource Include="..\..\Mphoto.App\Assets\icon.png" Link="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="Mphoto.payload.zip" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(UninstallerExe)')">
    <EmbeddedResource Include="$(UninstallerExe)" LogicalName="Mphoto.uninstall.exe" />
  </ItemGroup>

  <Target Name="ValidateSetupPayload" BeforeTargets="CoreCompile">
    <Warning Condition="!Exists('$(PayloadZip)')"
             Text="Falta $(PayloadZip). Ejecuta build-setup.ps1 para generar el instalador completo." />
    <Warning Condition="!Exists('$(UninstallerExe)')"
             Text="Falta $(UninstallerExe). Compila antes el proyecto Mphoto.Uninstall." />
  </Target>

</Project>
