<Window x:Class="Mphoto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Mphoto.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Mphoto" Width="1380" Height="880" MinWidth="1000" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" SnapsToDevicePixels="True" Icon="/Assets/icon.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ColorSwatch" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="#66FFFFFF" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Fill" Value="{StaticResource BorderBrush}" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolbarSeparator" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{StaticResource BorderBrush}" />
            <Setter Property="Margin" Value="8,6" />
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RaisedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9E2416" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
    <DockPanel x:Name="Root">

        <!-- ===== Barra de título ===== -->
        <Border DockPanel.Dock="Top" Height="34" Background="{StaticResource WindowBrush}"
                MouseLeftButtonDown="TitleArea_MouseLeftButtonDown">
            <DockPanel LastChildFill="False">
                <Image Source="/Assets/icon-mark.png" Width="16" Height="16" Margin="12,0,9,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="TitleText" Text="Mphoto" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            ToolTip="Minimizar" Click="Minimize_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            ToolTip="Maximizar" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                            ToolTip="Cerrar" Click="WindowClose_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Menú ===== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Archivo">
                <MenuItem Header="Nuevo…" InputGestureText="Ctrl+N" Click="New_Click" />
                <MenuItem Header="Abrir…" InputGestureText="Ctrl+O" Click="Open_Click" />
                <Separator />
                <MenuItem Header="Guardar" InputGestureText="Ctrl+S" Click="Save_Click" />
                <MenuItem Header="Guardar como…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                <MenuItem Header="Exportar copia…" InputGestureText="Ctrl+Shift+E" Click="Export_Click" />
                <Separator />
                <MenuItem Header="Salir" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>

            <MenuItem Header="Edición">
                <MenuItem x:Name="MenuUndo" Header="Deshacer" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                <MenuItem x:Name="MenuRedo" Header="Rehacer" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                <Separator />
                <MenuItem Header="Seleccionar todo" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                <MenuItem Header="Deseleccionar" InputGestureText="Ctrl+D" Click="Deselect_Click" />
                <MenuItem Header="Invertir selección" InputGestureText="Ctrl+Shift+I" Click="InvertSelection_Click" />
                <Separator />
                <MenuItem Header="Borrar contenido de la selección" InputGestureText="Supr" Click="DeleteSelection_Click" />
            </MenuItem>

            <MenuItem Header="Imagen">
                <MenuItem Header="Tamaño de la imagen…" Click="ResizeImage_Click" />
                <Separator />
                <MenuItem Header="Recortar a la selección" Click="CropToSelection_Click" />
                <MenuItem x:Name="MenuApplyCrop" Header="Aplicar recorte" InputGestureText="Intro" Click="ApplyCrop_Click" IsEnabled="False" />
                <MenuItem Header="Cancelar recorte" InputGestureText="Esc" Click="CancelCrop_Click" />
                <Separator />
                <MenuItem Header="Girar 90° a la derecha" Click="RotateRight_Click" />
                <MenuItem Header="Girar 90° a la izquierda" Click="RotateLeft_Click" />
                <MenuItem Header="Girar 180°" Click="Rotate180_Click" />
                <Separator />
                <MenuItem Header="Voltear horizontal" Click="FlipHorizontal_Click" />
                <MenuItem Header="Voltear vertical" Click="FlipVertical_Click" />
            </MenuItem>

            <MenuItem Header="Capa">
                <MenuItem Header="Nueva capa" InputGestureText="Ctrl+Shift+N" Click="AddLayer_Click" />
                <MenuItem Header="Duplicar capa" Click="DuplicateLayer_Click" />
                <MenuItem Header="Combinar hacia abajo" InputGestureText="Ctrl+E" Click="MergeDown_Click" />
                <Separator />
                <MenuItem Header="Subir capa" Click="MoveLayerUp_Click" />
                <MenuItem Header="Bajar capa" Click="MoveLayerDown_Click" />
                <Separator />
                <MenuItem Header="Limpiar capa" Click="ClearLayer_Click" />
                <MenuItem Header="Eliminar capa" Click="DeleteLayer_Click" />
            </MenuItem>

            <MenuItem Header="Ajustes">
                <MenuItem Header="Brillo y contraste…" Click="BrightnessContrast_Click" />
                <MenuItem Header="Tono y saturación…" Click="HueSaturation_Click" />
                <Separator />
                <MenuItem Header="Desaturar" Click="Desaturate_Click" />
                <MenuItem Header="Sepia" Click="Sepia_Click" />
                <MenuItem Header="Invertir colores" Click="InvertColors_Click" />
            </MenuItem>

            <MenuItem Header="Filtros">
                <MenuItem Header="Desenfoque…" Click="Blur_Click" />
                <MenuItem Header="Enfoque…" Click="Sharpen_Click" />
                <MenuItem Header="Pixelar…" Click="Pixelate_Click" />
                <MenuItem Header="Relieve…" Click="Emboss_Click" />
            </MenuItem>

            <MenuItem Header="Ver">
                <MenuItem Header="Ajustar a pantalla" InputGestureText="Ctrl+0" Click="Fit_Click" />
                <MenuItem Header="Tamaño real" InputGestureText="Ctrl+1" Click="ActualSize_Click" />
                <MenuItem Header="Acercar" InputGestureText="+" Click="ZoomIn_Click" />
                <MenuItem Header="Alejar" InputGestureText="-" Click="ZoomOut_Click" />
            </MenuItem>

            <MenuItem Header="Ayuda">
                <MenuItem Header="Acerca de Mphoto" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- ===== Barra de opciones ===== -->
        <Border DockPanel.Dock="Top" Height="42" Background="{StaticResource PanelAltBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <StackPanel x:Name="BrushOptions" Orientation="Horizontal">
                        <TextBlock Text="Tamaño" Style="{StaticResource MiniLabel}" />
                        <Slider x:Name="BrushSizeSlider" Width="130" Margin="8,0" Minimum="1" Maximum="300" Value="24"
                                ValueChanged="BrushSize_Changed" />
                        <TextBlock x:Name="BrushSizeValue" Style="{StaticResource ValueLabel}" Width="42" />
                        <Rectangle Style="{StaticResource ThinSeparator}" />
                        <TextBlock Text="Dureza" Style="{StaticResource MiniLabel}" />
                        <Slider x:Name="BrushHardnessSlider" Width="90" Margin="8,0" Minimum="0" Maximum="100" Value="85"
                                ValueChanged="BrushHardness_Changed" />
                        <TextBlock x:Name="BrushHardnessValue" Style="{StaticResource ValueLabel}" Width="38" />
                        <Rectangle Style="{StaticResource ThinSeparator}" />
                        <TextBlock Text="Opacidad" Style="{StaticResource MiniLabel}" />
                        <Slider x:Name="BrushOpacitySlider" Width="90" Margin="8,0" Minimum="1" Maximum="100" Value="100"
                                ValueChanged="BrushOpacity_Changed" />
                        <TextBlock x:Name="BrushOpacityValue" Style="{StaticResource ValueLabel}" Width="38" />
                    </StackPanel>

                    <StackPanel x:Name="ShapeOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Forma" Style="{StaticResource MiniLabel}" />
                        <ComboBox x:Name="ShapeKindBox" Width="130" Margin="8,0" SelectedIndex="0"
                                  SelectionChanged="ShapeKind_Changed">
                            <ComboBoxItem Content="Rectángulo" />
                            <ComboBoxItem Content="Elipse" />
                            <ComboBoxItem Content="Línea" />
                        </ComboBox>
                        <CheckBox x:Name="ShapeFillCheck" Content="Relleno" Margin="6,0,0,0" Checked="ShapeFill_Changed"
                                  Unchecked="ShapeFill_Changed" />
                        <Rectangle Style="{StaticResource ThinSeparator}" />
                        <TextBlock Text="Grosor" Style="{StaticResource MiniLabel}" />
                        <Slider x:Name="ShapeStrokeSlider" Width="90" Margin="8,0" Minimum="1" Maximum="60" Value="4"
                                ValueChanged="ShapeStroke_Changed" />
                        <TextBlock x:Name="ShapeStrokeValue" Style="{StaticResource ValueLabel}" Width="38" />
                        <Rectangle Style="{StaticResource ThinSeparator}" />
                        <TextBlock Text="Opacidad" Style="{StaticResource MiniLabel}" />
                        <Slider x:Name="ShapeOpacitySlider" Width="80" Margin="8,0" Minimum="1" Maximum="100" Value="100"
                                ValueChanged="ShapeOpacity_Changed" />
                        <TextBlock x:Name="ShapeOpacityValue" Style="{StaticResource ValueLabel}" Width="38" />
                    </StackPanel>

                    <StackPanel x:Name="FillOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Tolerancia" Style="{StaticResource MiniLabel}" />
                        <Slider x:Name="FillToleranceSlider" Width="140" Margin="8,0" Minimum="0" Maximum="100" Value="16"
                                ValueChanged="FillTolerance_Changed" />
                        <TextBlock x:Name="FillToleranceValue" Style="{StaticResource ValueLabel}" Width="38" />
                        <Rectangle Style="{StaticResource ThinSeparator}" />
                        <TextBlock Text="Haz clic en una zona de color uniforme para rellenarla." Style="{StaticResource MiniLabel}" />
                    </StackPanel>

                    <StackPanel x:Name="SelectOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Arrastra para definir la selección. Ctrl+D la deselecciona."
                                   Style="{StaticResource MiniLabel}" />
                    </StackPanel>

                    <StackPanel x:Name="CropOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="Aplicar recorte" Style="{StaticResource GhostButton}" Click="ApplyCrop_Click" />
                        <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                Click="CancelCrop_Click" />
                        <Rectangle Style="{StaticResource ThinSeparator}" />
                        <TextBlock x:Name="CropInfoText" Style="{StaticResource MiniLabel}" />
                    </StackPanel>

                    <StackPanel x:Name="TextOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Haz clic en el lienzo para elegir la posición del texto." Style="{StaticResource MiniLabel}" />
                    </StackPanel>

                    <StackPanel x:Name="ZoomOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Haz clic para acercar. Con Alt o el botón derecho, aleja."
                                   Style="{StaticResource MiniLabel}" />
                    </StackPanel>

                    <StackPanel x:Name="HandOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Arrastra para mover la vista. También puedes usar la rueda del ratón."
                                   Style="{StaticResource MiniLabel}" />
                    </StackPanel>

                    <StackPanel x:Name="EyedropperOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Haz clic para tomar el color como color principal. Botón derecho: secundario."
                                   Style="{StaticResource MiniLabel}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Color" Style="{StaticResource MiniLabel}" Margin="0,0,8,0" />
                    <Grid Width="58" Height="32" Margin="0,0,6,0">
                        <Button x:Name="SecondarySwatch" Style="{StaticResource ColorSwatch}" Width="24" Height="24"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="White"
                                ToolTip="Color secundario" Click="SecondarySwatch_Click" />
                        <Button x:Name="PrimarySwatch" Style="{StaticResource ColorSwatch}" Width="24" Height="24"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Background="Black"
                                ToolTip="Color principal" Click="PrimarySwatch_Click" />
                    </Grid>
                    <Button Content="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource PanelButton}" ToolTip="Intercambiar colores" Click="SwapColors_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Barra de estado ===== -->
        <Border DockPanel.Dock="Bottom" Height="27" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CursorText" Style="{StaticResource MiniLabel}" Width="96" />
                    <Rectangle Style="{StaticResource ThinSeparator}" />
                    <TextBlock x:Name="DocSizeText" Style="{StaticResource MiniLabel}" Margin="0,0,10,0" />
                    <Button Content="−" Style="{StaticResource PanelButton}" Width="22" Height="20" Click="ZoomOut_Click" />
                    <TextBlock x:Name="ZoomText" Style="{StaticResource MiniLabel}" Width="52"
                               TextAlignment="Center" Text="100 %" />
                    <Button Content="+" Style="{StaticResource PanelButton}" Width="22" Height="20" Click="ZoomIn_Click" />
                    <Button Content="Ajustar" Style="{StaticResource GhostButton}" FontSize="11" Padding="8,3"
                            Margin="6,0,0,0" Click="Fit_Click" />
                </StackPanel>
                <TextBlock x:Name="HintText" Style="{StaticResource MiniLabel}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ===== Herramientas ===== -->
        <Border DockPanel.Dock="Left" Width="54" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="6,8" HorizontalAlignment="Center">
                <ToggleButton x:Name="HandTool" Tag="Hand" Style="{StaticResource ToolButton}" Click="Tool_Click"
                              ToolTip="Mover la vista (H)">
                    <Path Data="M8,12 V7.5 A1.5,1.5 0 0 1 11,7.5 V12 M11,12 V6 A1.5,1.5 0 0 1 14,6 V12 M14,12 V7 A1.5,1.5 0 0 1 17,7 V12 M17,12 V9 A1.5,1.5 0 0 1 20,9 V15 C20,19 17,21.5 13,21.5 C10,21.5 8.5,20 7,17.5 L5,13.5 A1.5,1.5 0 0 1 7.5,12 L9,14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Width="21" Height="21" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton x:Name="ZoomTool" Tag="Zoom" Style="{StaticResource ToolButton}" Click="Tool_Click"
                              ToolTip="Zoom (Z)">
                    <Path Data="M10.5,4 A6.5,6.5 0 1 1 10.49,4 M15.5,15.5 L21,21 M8,10.5 H13 M10.5,8 V13"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="21" Height="21" Stretch="Uniform" />
                </ToggleButton>

                <Rectangle Style="{StaticResource ToolbarSeparator}" />

                <ToggleButton x:Name="RectSelectTool" Tag="RectSelect" Style="{StaticResource ToolButton}"
                              Click="Tool_Click" ToolTip="Selección rectangular (M)">
                    <Path Data="M4,4 H20 V20 H4 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeDashArray="2.4 2" Width="20" Height="20" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton x:Name="EllipseSelectTool" Tag="EllipseSelect" Style="{StaticResource ToolButton}"
                              Click="Tool_Click" ToolTip="Selección elíptica (Mayús+M)">
                    <Path Data="M12,4 C6.5,4 3,7.5 3,12 C3,16.5 6.5,20 12,20 C17.5,20 21,16.5 21,12 C21,7.5 17.5,4 12,4 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeDashArray="2.4 2" Width="20" Height="20" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton x:Name="LassoTool" Tag="Lasso" Style="{StaticResource ToolButton}" Click="Tool_Click"
                              ToolTip="Lazo (L)">
                    <Path Data="M12,4 C7,4 4,6.8 4,10.2 C4,13.6 7.2,15.6 12,15.6 C16.8,15.6 20,13.6 20,10.2 C20,6.8 17,4 12,4 Z M12,15.6 C11,18 10,20 7,21"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeDashArray="2.4 2" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton x:Name="CropTool" Tag="Crop" Style="{StaticResource ToolButton}" Click="Tool_Click"
                              ToolTip="Recortar (C)">
                    <Path Data="M7,3 V17 H21 M3,7 H17 V21"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="20" Height="20" Stretch="Uniform" />
                </ToggleButton>

                <Rectangle Style="{StaticResource ToolbarSeparator}" />

                <ToggleButton x:Name="BrushTool" Tag="Brush" Style="{StaticResource ToolButton}" Click="Tool_Click"
                              ToolTip="Pincel (B)">
                    <Path Data="M4,20 C4,17.5 5.5,16.2 8,16 L16.5,5.5 A2.1,2.1 0 0 1 19.5,7.5 L10,17.5 C9.8,19.5 8,21 4,20 Z M14.5,7 L17.5,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Width="21" Height="21" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton x:Name="EraserTool" Tag="Eraser" Style="{StaticResource ToolButton}" Click="Tool_Click"
                              ToolTip="Borrador (E)">
                    <Path Data="M4,15.5 L11.5,8 A2,2 0 0 1 14.3,8 L18,11.7 A2,2 0 0 1 18,14.5 L13,19.5 H8 Z M9.5,11 L15.5,17"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Width="21" Height="21" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton x:Name="FillTool" Tag="Fill" Style="{StaticResource ToolButton}" Click="Tool_Click"
                              ToolTip="Relleno (G)">
                    <Path Data="M5,11.5 L11.5,5 L18.5,12 L12,18.5 Z M11.5,5 L9,7.5 M18.5,15.5 C18.5,15.5 20.5,17.5 20.5,18.7 A1.7,1.7 0 0 1 17.1,18.7 C17.1,17.5 18.5,15.5 18.5,15.5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Width="21" Height="21" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton x:Name="ShapeTool" Tag="Shape" Style="{StaticResource ToolButton}" Click="Tool_Click"
                              ToolTip="Formas (U)">
                    <Path Data="M4,4 H13 V13 H4 Z M18,10 A5,5 0 1 1 17.9,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="21" Height="21" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton x:Name="TextTool" Tag="Text" Style="{StaticResource ToolButton}" Click="Tool_Click"
                              ToolTip="Texto (T)">
                    <Path Data="M5,5 H19 M12,5 V19 M8,19 H16"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="20" Height="20" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton x:Name="EyedropperTool" Tag="Eyedropper" Style="{StaticResource ToolButton}"
                              Click="Tool_Click" ToolTip="Cuentagotas (I)">
                    <Path Data="M16,4 A2.8,2.8 0 0 1 20,8 L17,11 L13,7 Z M13,7 L5,15 L4,20 L9,19 L17,11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Width="21" Height="21" Stretch="Uniform" />
                </ToggleButton>
            </StackPanel>
        </Border>

        <!-- ===== Panel derecho ===== -->
        <Border DockPanel.Dock="Right" Width="302" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Capas -->
                <DockPanel Grid.Row="0" Margin="12,12,12,10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="CAPAS" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PanelButton}" Content="+" FontSize="16" ToolTip="Nueva capa"
                                    Click="AddLayer_Click" />
                            <Button Style="{StaticResource PanelButton}" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                    FontSize="11" ToolTip="Duplicar capa" Click="DuplicateLayer_Click" />
                            <Button Style="{StaticResource PanelButton}" Content="&#xE74B;" FontFamily="Segoe MDL2 Assets"
                                    FontSize="11" ToolTip="Combinar hacia abajo" Click="MergeDown_Click" />
                            <Button Style="{StaticResource PanelButton}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                    FontSize="11" ToolTip="Eliminar capa" Click="DeleteLayer_Click" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fusión" Style="{StaticResource MiniLabel}" Margin="0,0,8,0" />
                            <ComboBox x:Name="BlendBox" Grid.Column="1" SelectionChanged="Blend_Changed" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Opacidad" Style="{StaticResource MiniLabel}" Margin="0,0,8,0" />
                            <Slider x:Name="LayerOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100"
                                    ValueChanged="LayerOpacity_Changed" Margin="0,0,8,0" />
                            <TextBlock x:Name="LayerOpacityValue" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                        </Grid>
                    </StackPanel>

                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="3">
                        <ListBox x:Name="LayerList" SelectionChanged="LayerList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="42">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0" Width="20" Height="20" Style="{StaticResource IconToggle}"
                                                      IsChecked="{Binding Visible, Mode=TwoWay}" Click="LayerVisibility_Click"
                                                      ToolTip="Mostrar u ocultar">
                                            <Path x:Name="EyeIcon"
                                                  Data="M2,10 C5,5 15,5 18,10 C15,15 5,15 2,10 Z M10,7.6 A2.4,2.4 0 1 1 9.9,7.6"
                                                  Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.3"
                                                  Width="17" Height="17" Stretch="Uniform" />
                                        </ToggleButton>
                                        <Border x:Name="ThumbFrame" Grid.Column="1" Width="36" Height="34"
                                                CornerRadius="4" Background="{StaticResource CheckerTinyBrush}"
                                                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                                                ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="8,0,2,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="InfoText" Text="{Binding Info}"
                                                       Foreground="{StaticResource TextDimBrush}" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Visible}" Value="False">
                                            <Setter TargetName="ThumbFrame" Property="Opacity" Value="0.35" />
                                            <Setter TargetName="NameText" Property="Opacity" Value="0.5" />
                                            <Setter TargetName="InfoText" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>

                <!-- Historial -->
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="HISTORIAL" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                        <Border Height="152" Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="7"
                                Padding="3">
                            <ListBox x:Name="HistoryList" SelectionChanged="HistoryList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="Dot" Grid.Column="0" Width="7" Height="7"
                                                     Fill="{StaticResource TextDimBrush}" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="LabelText" Grid.Column="1" Text="{Binding Label}"
                                                       FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="LabelText" Property="Foreground" Value="{StaticResource TextBrush}" />
                                                <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Color -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0"
                        Padding="12,10,12,12">
                    <StackPanel>
                        <TextBlock Text="COLOR" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="58" Height="46">
                                <Button x:Name="DockSecondarySwatch" Style="{StaticResource ColorSwatch}" Width="32" Height="32"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="White"
                                        Click="SecondarySwatch_Click" ToolTip="Color secundario" />
                                <Button x:Name="DockPrimarySwatch" Style="{StaticResource ColorSwatch}" Width="32" Height="32"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Background="Black"
                                        Click="PrimarySwatch_Click" ToolTip="Color principal" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock x:Name="PrimaryHexText" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Color principal" Style="{StaticResource MiniLabel}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Editar" Style="{StaticResource GhostButton}" FontSize="11"
                                    Padding="8,4" VerticalAlignment="Center" Click="PrimarySwatch_Click" />
                        </Grid>
                        <UniformGrid x:Name="QuickPalette" Columns="10" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Lienzo ===== -->
        <Border Background="{StaticResource BackdropBrush}">
            <controls:CanvasView x:Name="Canvas" />
        </Border>
    </DockPanel>
    </Border>
</Window>
