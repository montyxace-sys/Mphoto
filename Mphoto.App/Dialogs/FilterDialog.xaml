<Window x:Class="Mphoto.Dialogs.FilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filtro" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI" SnapsToDevicePixels="True">
    <Border Style="{StaticResource DialogRoot}" Width="480" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderArea" Grid.Row="0" Padding="20,15,12,10" Background="Transparent">
                <DockPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource PanelButton}"
                            Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitle}" />
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,2,20,6">
                <Border Height="190" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Background="{StaticResource CheckerBrush}" ClipToBounds="True">
                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <TextBlock x:Name="DescriptionText" Style="{StaticResource MiniLabel}" Margin="0,12,0,0"
                           TextWrapping="Wrap" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Label1" Grid.Column="0" Style="{StaticResource MiniLabel}" />
                    <Slider x:Name="AmountSlider" Grid.Column="1" Margin="0,0,10,0" ValueChanged="Slider_Changed" />
                    <TextBlock x:Name="Value1" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="2" Padding="20,10,20,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="Aplicar" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
