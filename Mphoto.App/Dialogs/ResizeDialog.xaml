<Window x:Class="Mphoto.Dialogs.ResizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tamaño de imagen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI" SnapsToDevicePixels="True">
    <Border Style="{StaticResource DialogRoot}" Width="440" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderArea" Grid.Row="0" Padding="20,15,12,10" Background="Transparent">
                <DockPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource PanelButton}"
                            Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    <TextBlock Text="Tamaño de la imagen" Style="{StaticResource DialogTitle}" />
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,4,20,8">
                <TextBlock x:Name="CurrentText" Style="{StaticResource MiniLabel}" Margin="0,0,0,14" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Anchura (px)" Style="{StaticResource MiniLabel}" Margin="0,0,0,6" />
                        <TextBox x:Name="WidthBox" Height="32" MaxLength="5" LostFocus="Width_LostFocus" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Altura (px)" Style="{StaticResource MiniLabel}" Margin="0,0,0,6" />
                        <TextBox x:Name="HeightBox" Height="32" MaxLength="5" LostFocus="Height_LostFocus" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="KeepAspect" Content="Mantener proporciones" IsChecked="True" Margin="0,16,0,0" />

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="11.5"
                           Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2" Padding="20,8,20,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="Aplicar" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
