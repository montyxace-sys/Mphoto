<Window x:Class="Mphoto.Dialogs.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI" SnapsToDevicePixels="True">
    <Border Style="{StaticResource DialogRoot}" Width="430" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderArea" Grid.Row="0" Padding="20,15,12,10" Background="Transparent">
                <DockPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource PanelButton}"
                            Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    <TextBlock Text="Elegir color" Style="{StaticResource DialogTitle}" />
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,2,20,6">
                <Border Height="46" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Border x:Name="PreviewSwatch" CornerRadius="5" />
                </Border>

                <TextBlock Text="Paleta" Style="{StaticResource MiniLabel}" Margin="0,14,0,6" />
                <UniformGrid x:Name="SwatchGrid" Columns="10" Rows="4" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="R" Style="{StaticResource MiniLabel}" />
                    <Slider x:Name="RedSlider" Grid.Column="1" Margin="0,0,10,0" Maximum="255" ValueChanged="Rgb_Changed" />
                    <TextBlock x:Name="RedValue" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="G" Style="{StaticResource MiniLabel}" />
                    <Slider x:Name="GreenSlider" Grid.Column="1" Margin="0,0,10,0" Maximum="255" ValueChanged="Rgb_Changed" />
                    <TextBlock x:Name="GreenValue" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="B" Style="{StaticResource MiniLabel}" />
                    <Slider x:Name="BlueSlider" Grid.Column="1" Margin="0,0,10,0" Maximum="255" ValueChanged="Rgb_Changed" />
                    <TextBlock x:Name="BlueValue" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="Hex" Style="{StaticResource MiniLabel}" Margin="0,0,10,0" />
                    <TextBox x:Name="HexBox" Width="110" Height="28" MaxLength="7" TextChanged="Hex_Changed" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="2" Padding="20,10,20,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="Aceptar" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
