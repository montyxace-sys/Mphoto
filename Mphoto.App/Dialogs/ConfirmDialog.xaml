<Window x:Class="Mphoto.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mphoto" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI" SnapsToDevicePixels="True">
    <Border Style="{StaticResource DialogRoot}" Width="430" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderArea" Grid.Row="0" Padding="20,15,12,10" Background="Transparent">
                <DockPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource PanelButton}"
                            Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitle}" />
                </DockPanel>
            </Border>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="20,6,20,22" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" LineHeight="19" />

            <Border Grid.Row="2" Padding="20,4,20,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PrimaryButton" Content="Guardar" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0" Click="Primary_Click" IsDefault="True" />
                    <Button x:Name="SecondaryButton" Content="No guardar" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" Click="Secondary_Click" />
                    <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource GhostButton}"
                            Click="Cancel_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
