<Window x:Class="Mphoto.Dialogs.NewDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo documento" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI" SnapsToDevicePixels="True">
    <Border Style="{StaticResource DialogRoot}" Width="470" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderArea" Grid.Row="0" Padding="20,15,12,10" Background="Transparent">
                <DockPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource PanelButton}"
                            Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    <TextBlock Text="Nuevo documento" Style="{StaticResource DialogTitle}" />
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,4,20,8">
                <TextBlock Text="Ajuste predefinido" Style="{StaticResource MiniLabel}" Margin="0,0,0,6" />
                <ComboBox x:Name="PresetBox" SelectedIndex="0" SelectionChanged="Preset_Changed">
                    <ComboBoxItem Content="Personalizado" />
                    <ComboBoxItem Content="Pantalla Full HD · 1920 × 1080" />
                    <ComboBoxItem Content="Pantalla QHD · 2560 × 1440" />
                    <ComboBoxItem Content="A4 horizontal · 3508 × 2480" />
                    <ComboBoxItem Content="A4 vertical · 2480 × 3508" />
                    <ComboBoxItem Content="Instagram · 1080 × 1080" />
                    <ComboBoxItem Content="Web · 1280 × 720" />
                    <ComboBoxItem Content="Miniatura · 640 × 360" />
                </ComboBox>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Anchura (px)" Style="{StaticResource MiniLabel}" Margin="0,0,0,6" />
                        <TextBox x:Name="WidthBox" Text="1920" Height="32" MaxLength="5" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Altura (px)" Style="{StaticResource MiniLabel}" Margin="0,0,0,6" />
                        <TextBox x:Name="HeightBox" Text="1080" Height="32" MaxLength="5" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Fondo" Style="{StaticResource MiniLabel}" Margin="0,16,0,6" />
                <ComboBox x:Name="BackgroundBox" SelectedIndex="0">
                    <ComboBoxItem Content="Blanco" />
                    <ComboBoxItem Content="Transparente" />
                </ComboBox>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="11.5"
                           Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2" Padding="20,8,20,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Click="Cancel_Click" />
                    <Button Content="Crear documento" Style="{StaticResource PrimaryButton}" IsDefault="True"
                            Click="Ok_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
